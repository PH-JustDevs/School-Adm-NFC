# Conexão usada pelo app em produção. Pode ser o pooler do provedor
# (Supabase: porta 6543 / Neon: "pooled").
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?sslmode=require"

# Conexão direta, usada só por `npm run db:push` (migrações do Prisma).
# No Supabase: porta 5432 (não o pooler de transação).
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres?sslmode=require"

# Administrador único do sistema
ADMIN_EMAIL="admin@escola.exemplo"
# Gere com: PASSWORD='sua-senha-forte' npm run hash-password
# Use aspas duplas e escape cada cifrão como barra + cifrão (senão o Next apaga o valor).
# Exemplo: ADMIN_PASSWORD_HASH="\$2b\$12\$..." (o hash-password já imprime nesse formato)
ADMIN_PASSWORD_HASH=""

# Segredo para assinar a sessão (mínimo 32 caracteres). Ex.: openssl rand -base64 48
SESSION_SECRET=""

# URL pública do app (gravada nos QR Codes). Ex.: https://riachuelo-nfc.vercel.app
APP_URL="http://localhost:3000"
